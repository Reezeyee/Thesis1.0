<?xml version="1.0" encoding="utf-8"?>
<!-- 
  IF you get Configuration_not_found and google-services.json still has empty oauth_client:
  1. Copy this file to: app/src/main/res/values/firebase_secrets.xml
  2. Replace PASTE_WEB_CLIENT_ID below with your Web client id from:
     https://console.cloud.google.com/apis/credentials?project=thesis-bbcde
     (OAuth 2.0 → type "Web application")
  3. tools:node="replace" overrides the duplicate from the google-services merge — do not
     also use Gradle resValue for the same string (that caused merge errors).
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="default_web_client_id" translatable="false" tools:node="replace">PASTE_WEB_CLIENT_ID</string>
</resources>
