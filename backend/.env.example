HOST=0.0.0.0
PORT=8000
DEBUG=True
ROBOFLOW_API_KEY=your-roboflow-api-key
ROBOFLOW_MODEL_ID=coffee-fruit-maturity-befkg-q80dw
ROBOFLOW_VERSION=1
CORS_ORIGINS=*

# API key auth for /predict and /correct.
# Do NOT put the raw key here. Run this once to generate a key + hashfile:
#   python backend/generate_api_key.py
# It writes backend/api_key.hash and prints the raw key one time -- put that
# raw key in the CALLER's env (e.g. the website's VITE_BACKEND_API_KEY), not here.
# Alternatively, paste a SHA-256 hash directly:
# API_KEY_HASH=

# Path to the Firebase Admin SDK service account JSON, used only by the
# /admin/reset-worker-password endpoint (admin-approved worker password
# resets that don't require a real email address). Download it from
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key, save it at backend/serviceAccountKey.json, and leave this
# unset (that's the default path) or point it elsewhere:
# FIREBASE_SERVICE_ACCOUNT_PATH=backend/serviceAccountKey.json
