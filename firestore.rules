rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Owner account: read-only. Sees profit/revenue on the website but must never be able to
    // write farm data -- checked against the `role` field on their own /users/{uid} profile doc.
    function isOwnerRole() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'OWNER';
    }

    // Buyer account: self-registered, storefront-only. Reads the shared farm state (to browse
    // product listings) but must never write it -- orders go through the separate buyer_orders
    // collection below instead.
    function isBuyerRole() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'BUYER';
    }

    // Only accounts whose /users/{uid} profile carries a trusted staff role may write farm data.
    // Being merely signed in is not enough: Firebase Auth sign-up is public, so a brand-new
    // account has no profile at all. Trusted profiles (FARM_STAFF / ADMINISTRATOR) can only be
    // written by the admin or the Admin SDK -- see the /users rule below -- so nobody can grant
    // themselves this role.
    function isStaffRole() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['FARM_STAFF', 'ADMINISTRATOR'];
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'farmacojido@gmail.com';
    }

    // App snapshot: `app_state/farm` holds shared farm structure (readable by any authenticated
    // user, writable only by staff-role accounts and the admin -- see isStaffRole).
    // `app_state/{authUid}` holds that worker's own private, worker-submitted records
    // (attendance, leave requests, field reports, ...) -- a worker may only read/write their own
    // doc. The admin account may read/write every doc so the website can merge every worker's
    // private records for review and write back approve/reject/resolve decisions to the correct
    // worker's doc.
    match /app_state/{docId} {
      allow read: if request.auth != null && (
        request.auth.uid == docId ||
        docId == 'farm' ||
        request.auth.token.email == 'farmacojido@gmail.com'
      );
      allow write: if isAdmin() || (
        (request.auth.uid == docId || docId == 'farm') && isStaffRole()
      );
    }

    // Mirrored list JSON: legacy per-uid OR shared `farm` subtree. Same staff-role-only write rule.
    match /user_data/{ownerId}/{subCollection}/{docId} {
      allow read: if request.auth != null && (
        request.auth.uid == ownerId || ownerId == 'farm'
      );
      allow write: if isAdmin() || (
        (request.auth.uid == ownerId || ownerId == 'farm') && isStaffRole()
      );
    }

    // Buyer orders: every order is picked up at the farm by the buyer (no delivery). A Buyer may
    // only create an order under their own uid (status must start 'pending', never self-marked
    // ready/fulfilled/cancelled) and read their own orders. Admin may list every order and
    // approve ('ready' -- notifies the buyer to pick it up), fulfill, or cancel one.
    match /buyer_orders/{orderId} {
      allow create: if request.auth != null &&
        request.resource.data.buyerUid == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow read: if request.auth != null && (
        resource.data.buyerUid == request.auth.uid || isAdmin()
      );

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // Stock holds: placing an order also writes a hold (same document id as the order) so every buyer
    // sees the ordered quantity come off the available stock immediately, before Admin fulfils it.
    // Any signed-in user may read holds (they contain only the ordered items). A hold can only be
    // created in the same batch as the buyer's own matching order -- checked with getAfter -- and with
    // exactly that order's items, so it can't be forged, inflated, or attached to someone else's order.
    // Buyers can never edit or delete a hold; Admin releases it when the order is cancelled or fulfilled.
    match /stock_holds/{holdId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['items', 'createdAt']) &&
        getAfter(/databases/$(database)/documents/buyer_orders/$(holdId)).data.buyerUid == request.auth.uid &&
        request.resource.data.items == getAfter(/databases/$(database)/documents/buyer_orders/$(holdId)).data.items;

      allow update: if false;
      allow delete: if isAdmin();
    }

    // Repair jobs: the admin sends a broken-equipment or sprinkler-damage report to ONE Maintenance worker by
    // creating a job (id = "<kind>-<reportId>") that holds a copy of what that worker needs to see. Workers'
    // reports live in each worker's private document, which other workers can't read -- so this separate job is
    // how Maintenance sees them. Only the admin creates, reassigns and deletes jobs. The assigned worker (matched
    // by uid) may read only their own jobs and change nothing but the progress fields: start it, then mark it
    // fixed with a short note saying what was done and which parts were used. Once fixed, only the admin can change it again.
    match /repair_jobs/{jobId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.get('assignedToUid', '') == request.auth.uid);

      allow create, delete: if isAdmin();

      allow update: if isAdmin() || (
        request.auth != null &&
        resource.data.get('assignedToUid', '') == request.auth.uid &&
        resource.data.status != 'fixed' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'startedAt', 'fixedAt', 'fixNote', 'partsUsed']) &&
        request.resource.data.status in ['in_progress', 'fixed'] &&
        (request.resource.data.status != 'fixed' || (
          request.resource.data.get('fixNote', '') is string &&
          request.resource.data.get('fixNote', '').size() > 0 &&
          request.resource.data.get('fixNote', '').size() <= 500 &&
          request.resource.data.get('fixedAt', '') is string &&
          // The parts / materials used up (e.g. 4 screws) -- optional, at most 10 entries. The website reads
          // each entry defensively, since rules cannot look inside a list.
          request.resource.data.get('partsUsed', []) is list &&
          request.resource.data.get('partsUsed', []).size() <= 10
        ))
      );
    }

    // Direct Admin <-> Owner message thread: exactly one Admin and one Owner account exist, so
    // this is a single shared thread, not per-conversation documents. Both roles may read every
    // message and create new ones; only Admin may edit/delete (e.g. to remove a mistaken send).
    match /owner_admin_messages/{messageId} {
      allow read: if isAdmin() || isOwnerRole();

      allow create: if (isAdmin() || isOwnerRole()) &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.senderRole in ['ADMINISTRATOR', 'OWNER'] &&
        request.resource.data.body is string &&
        request.resource.data.body.size() > 0 &&
        request.resource.data.body.size() <= 2000;

      allow update, delete: if isAdmin();
    }

    // Profile and metadata. Admin may also read (get and list/query) every profile so the
    // website can plot self-registered buyers' mandatory location on the buyer locations map
    // in Maintenance -- writes stay restricted to the profile's own owner.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Public sign-up means anyone can hold a Firebase account, so a profile may never be used
      // to self-assign a trusted role: an account can only create its OWN profile as a BUYER, and
      // can never change its own `role` afterwards (updates that keep the role -- last sign-in
      // time, clearing mustChangePassword, display name -- stay allowed). FARM_STAFF / OWNER /
      // ADMINISTRATOR profiles are written by the admin (web worker form) or the Admin SDK.
      allow create: if isAdmin() ||
        (request.auth != null && request.auth.uid == userId && request.resource.data.role == 'BUYER');
      allow update: if isAdmin() ||
        (request.auth != null && request.auth.uid == userId &&
          request.resource.data.get('role', null) == resource.data.get('role', null));
      allow delete: if isAdmin();
    }

    match /users/{userId}/login_history/{entryId} {
      allow read, create: if request.auth != null && request.auth.uid == userId;
    }

    // Password reset requests: a signed-out worker (they forgot their password, so they
    // cannot be authenticated) files a request with exactly these validated fields.
    // The worker's app polls its own request's status by document id (an unguessable
    // auto-generated id), so single-document reads (`get`) stay open to signed-out
    // callers. Listing/querying the whole collection is a separate permission in
    // Firestore rules and is deliberately NOT granted here -- `allow read` would let
    // anyone enumerate every pending request (emails, names, messages) via a query,
    // not just fetch one they already know the id of. Only the admin account can
    // list, update (approve/resolve), or delete requests.
    match /password_reset_requests/{requestId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'email',
          'displayName',
          'role',
          'requestedAt',
          'source',
          'status',
          'message'
        ]) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() <= 120 &&
        request.resource.data.role in ['ADMINISTRATOR', 'FARM_STAFF'] &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 240 &&
        request.resource.data.requestedAt == request.time &&
        request.resource.data.source == 'android' &&
        request.resource.data.status == 'pending';

      allow get: if true;

      allow list, update, delete: if
        request.auth != null &&
        request.auth.token.email == 'farmacojido@gmail.com';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
