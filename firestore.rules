rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Owner account: read-only. Sees profit/revenue on the website but must never be able to
    // write farm data -- checked against the `role` field on their own /users/{uid} profile doc.
    function isOwnerRole() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'OWNER';
    }

    // Buyer account: self-registered, storefront-only. Reads the shared farm state (to browse
    // product listings) but must never write it -- orders go through the separate buyer_orders
    // collection below instead.
    function isBuyerRole() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'BUYER';
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'farmacojido@gmail.com';
    }

    // App snapshot: `app_state/farm` holds shared farm structure (readable by any authenticated
    // user, writable by any authenticated user EXCEPT the read-only Owner role).
    // `app_state/{authUid}` holds that worker's own private, worker-submitted records
    // (attendance, leave requests, field reports, ...) -- a worker may only read/write their own
    // doc. The admin account may read/write every doc so the website can merge every worker's
    // private records for review and write back approve/reject/resolve decisions to the correct
    // worker's doc.
    match /app_state/{docId} {
      allow read: if request.auth != null && (
        request.auth.uid == docId ||
        docId == 'farm' ||
        request.auth.token.email == 'farmacojido@gmail.com'
      );
      allow write: if request.auth != null && (
        request.auth.uid == docId ||
        docId == 'farm' ||
        request.auth.token.email == 'farmacojido@gmail.com'
      ) && !isOwnerRole() && !isBuyerRole();
    }

    // Mirrored list JSON: legacy per-uid OR shared `farm` subtree. Same Owner/Buyer read-only carve-out.
    match /user_data/{ownerId}/{subCollection}/{docId} {
      allow read: if request.auth != null && (
        request.auth.uid == ownerId || ownerId == 'farm'
      );
      allow write: if request.auth != null && (
        request.auth.uid == ownerId || ownerId == 'farm'
      ) && !isOwnerRole() && !isBuyerRole();
    }

    // Buyer orders: a Buyer may only create an order under their own uid (status must start
    // 'pending', never self-marked fulfilled/cancelled) and read their own orders; only Admin
    // may list every order, or update/cancel/fulfill one.
    match /buyer_orders/{orderId} {
      allow create: if request.auth != null &&
        request.resource.data.buyerUid == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow read: if request.auth != null && (
        resource.data.buyerUid == request.auth.uid || isAdmin()
      );

      allow update, delete: if isAdmin();
    }

    // Direct Admin <-> Owner message thread: exactly one Admin and one Owner account exist, so
    // this is a single shared thread, not per-conversation documents. Both roles may read every
    // message and create new ones; only Admin may edit/delete (e.g. to remove a mistaken send).
    match /owner_admin_messages/{messageId} {
      allow read: if isAdmin() || isOwnerRole();

      allow create: if (isAdmin() || isOwnerRole()) &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.senderRole in ['ADMINISTRATOR', 'OWNER'] &&
        request.resource.data.body is string &&
        request.resource.data.body.size() > 0 &&
        request.resource.data.body.size() <= 2000;

      allow update, delete: if isAdmin();
    }

    // Profile and metadata.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/login_history/{entryId} {
      allow read, create: if request.auth != null && request.auth.uid == userId;
    }

    // Password reset requests: a signed-out worker (they forgot their password, so they
    // cannot be authenticated) files a request with exactly these validated fields.
    // The worker's app polls its own request's status by document id (an unguessable
    // auto-generated id), so single-document reads (`get`) stay open to signed-out
    // callers. Listing/querying the whole collection is a separate permission in
    // Firestore rules and is deliberately NOT granted here -- `allow read` would let
    // anyone enumerate every pending request (emails, names, messages) via a query,
    // not just fetch one they already know the id of. Only the admin account can
    // list, update (approve/resolve), or delete requests.
    match /password_reset_requests/{requestId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'email',
          'displayName',
          'role',
          'requestedAt',
          'source',
          'status',
          'message'
        ]) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() <= 120 &&
        request.resource.data.role in ['ADMINISTRATOR', 'FARM_STAFF'] &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 240 &&
        request.resource.data.requestedAt == request.time &&
        request.resource.data.source == 'android' &&
        request.resource.data.status == 'pending';

      allow get: if true;

      allow list, update, delete: if
        request.auth != null &&
        request.auth.token.email == 'farmacojido@gmail.com';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
